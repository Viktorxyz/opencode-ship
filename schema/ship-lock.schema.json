{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Viktorxyz/opencode-ship/schema/ship-lock.schema.json",
  "title": "opencode-ship install lock",
  "type": "object",
  "required": ["contractVersion", "manager", "files", "integrity"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "enum": [1, 2, 3, 4, 5] },
    "manager": {
      "type": "object",
      "required": ["schemaVersion", "name", "version", "appliedAt", "config"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "enum": [1, 2, 3, 4, 5] },
        "name": { "type": "string", "pattern": "^opencode-ship$" },
        "version": { "type": "string", "minLength": 1 },
        "templateSet": { "type": "string", "minLength": 1 },
        "profile": {
          "enum": ["core", "engineering"],
          "description": "Profile the lock was applied under. Required on locks written at schema 2; absent on legacy schema-1 locks (resolved to core by the profile precedence layer)."
        },
        "appliedAt": { "type": "string", "format": "date-time" },
        "setupComplete": {
          "type": "boolean",
          "description": "True when the consumer has finished the chat-only setup workflow. Sole writer is the opencode-ship setup-complete command."
        },
        "config": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "existed": { "type": "boolean" }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planner", "builder", "finalReviewer"],
          "properties": {
            "planner": { "$ref": "#/$defs/modelProvenance" },
            "builder": { "$ref": "#/$defs/modelProvenance" },
            "finalReviewer": { "$ref": "#/$defs/modelProvenance" }
          }
        },
        "rootDocuments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "pointers"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["json", "jsonc"] },
              "pointers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["pointer", "strategy", "scope", "installedSha256", "previous"],
                  "additionalProperties": false,
                  "properties": {
                    "pointer": { "type": "string", "pattern": "^/" },
                    "strategy": { "enum": ["value", "object-entry", "array-member"] },
                    "scope": { "enum": ["core", "engineering"] },
                    "installedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "previous": {
                      "type": "object",
                      "required": ["existed"],
                      "additionalProperties": true,
                      "properties": {
                        "existed": { "type": "boolean" },
                        "value": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "mode"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
          "template": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["plugin", "agent", "skill", "config", "lock", "support"] }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["lockSha256"],
      "additionalProperties": false,
      "properties": {
        "lockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opencodeMin": { "type": "string" },
        "coreVersion": { "type": "string" }
      }
    }
  },
  "$defs": {
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "applied"],
      "properties": {
        "source": { "enum": ["default", "override"] },
        "applied": { "type": "string", "minLength": 1 }
      }
    }
  }
}
